targetScope = 'resourceGroup'

metadata description = 'Read-only Sentinel ingestion analytics and commitment-tier what-if workbook.'

@description('Location of the existing Sentinel workspace.')
param location string

@description('Workbook content generated by New-SentinelUsageWorkbook.ps1.')
param workbookContent object

@description('Stable workbook ID; repeat deployments update the same workbook.')
param workbookName string = guid(toLower(workbookContent.fallbackResourceIds[0]), 'sentinel-usage-and-commitment-tiers')

resource workbook 'Microsoft.Insights/workbooks@2023-06-01' = {
  name: workbookName
  location: location
  kind: 'shared'
  tags: {
    workload: 'sentinel-usage'
    managedBy: 'bicep'
  }
  properties: {
    displayName: 'Sentinel - Usage and commitment tier what-if'
    category: 'sentinel'
    sourceId: workbookContent.fallbackResourceIds[0]
    serializedData: string(workbookContent)
    version: '1.0'
  }
}

output workbookId string = workbook.id
output portalUrl string = 'https://portal.azure.com/#resource${workbook.id}/workbook'
